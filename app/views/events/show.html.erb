<% content_for(:title, "gather - " + pretty_string(@user.username) + "'s event") %>
<div class="event-wrapper">
  <div class="event">
    <div class="event-links">
      <%= link_to "← Back to events", root_path %>
      <% if user_authorized?(@event) %>
      <%= link_to "Edit event", edit_user_event_path %>
      <% end %>
    </div>
    <div class="event-body">
      <%= tag.div tag.strong(@event.privacy, class: "capitalize"), class:"event-privacy", data: { privacy: @event.privacy } %>
