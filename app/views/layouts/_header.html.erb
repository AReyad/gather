<header>
    <nav class = "nav-bar">
    <h1><%= link_to "gather", root_path, class: "website-title" %></h1>
      <ul>
        <% if user_signed_in? %>
          <%= link_to new_event_path, class: "button-style regular" do %>
          <li>New Event</li>
          <% end %>
          <div class="nav-bar-user">
          <li class="button-style accent capitalize user-icon">
            <p><%= current_user.username %></p>
             <%= image_tag 'arrow.svg', class: "icon" %>
          </li>
            <div class="user-controls">
              <%= link_to "New Event", new_event_path, class: "user-new-event" %>
              <%= link_to "Your profile", user_path(current_user.username) %>
              <%= button_to "Log out", signout_path, method: :delete, data: { turbo: false }, class: "sign-out-btn" %>
            </div>
          </div>
        <% else %>
            <button class="menu"><svg class="icon menu" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 122.88 95.95" style="enable-background:new 0 0 122.88 95.95" xml:space="preserve"><g><path fill="currentColor" d="M8.94,0h105c4.92,0,8.94,4.02,8.94,8.94l0,0c0,4.92-4.02,8.94-8.94,8.94h-105C4.02,17.88,0,13.86,0,8.94l0,0 C0,4.02,4.02,0,8.94,0L8.94,0z M8.94,78.07h105c4.92,0,8.94,4.02,8.94,8.94l0,0c0,4.92-4.02,8.94-8.94,8.94h-105 C4.02,95.95,0,91.93,0,87.01l0,0C0,82.09,4.02,78.07,8.94,78.07L8.94,78.07z M8.94,39.03h105c4.92,0,8.94,4.02,8.94,8.94l0,0 c0,4.92-4.02,8.94-8.94,8.94h-105C4.02,56.91,0,52.89,0,47.97l0,0C0,43.06,4.02,39.03,8.94,39.03L8.94,39.03z"/></g></svg></button>
            <div class="user-controls">
              <%= link_to "Sign in", signin_path %>
              <%= link_to "Create an account", signup_path %>
            </div>
          <%= link_to signin_path, class: "button-style accent" do %>
            <li>Sign in</li>
          <% end %>
          <%= link_to signup_path, class: "button-style regular" do %>
          <li>Create an account</li>
          <% end %>
        <%end %>
      </ul>
    </nav>
</header>
<div class="border"></div>