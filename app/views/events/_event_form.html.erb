<%= form_with model: event, url: url do |form|%>
  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, placeholder: "Rails Workshop 2026", required: true,
        minlength: EventValidations::MIN_TITLE_LENGTH, maxlength: EventValidations::MAX_TITLE_LENGTH %>
  </div>

  <div class="field description">
    <%= form.label :description %>
    <%= form.text_area :description, placeholder: "Deep dive into rails with our worksh...",
        required: true, minlength: EventValidations::MIN_DESCRIPTION_LENGTH, maxlength: EventValidations::MAX_DESCRIPTION_LENGTH %>
  </div>
  <div class="date-time">
    <div class="field">
      <%= form.label :date %>
      <%= form.date_field :date, required: true, value: event.date || EventValidations.min_date, min: EventValidations.min_date - 1.day, max: EventValidations.max_date %>
    </div>
    <div class="field">
      <%= form.label :time %>
      <%= form.time_field :time, value: event.time || "18:00", required: true %>
    </div>
  </div>

  <div class="field">
    <%= form.label :location %>
    <%= form.text_field :location, placeholder: "San Francisco, CA", required: true,
        minlength: EventValidations::MIN_LOCATION_LENGTH, maxlength: EventValidations::MAX_LOCATION_LENGTH %>
  </div>

  <div class="field">
    <p class="label">Privacy</p>
    <div class="radio-group no-flex">
    <%= form.radio_button :privacy, :public, checked: true, class: "public-event" %>
    <%= form.label :privacy_public, "Public" %>
    <p class="public description">Anyone can attend this event.</p>
    <%= form.radio_button :privacy, :private, class: "private-event" %>
    <%= form.label :privacy_private, "Private" %>
    <p class="private description">Only people invited can attend.</p>
    <div class="description"></div>
    </div>
  </div>

  <div class="actions">
    <%= link_to "Cancel", root_path, class: "danger" %>
    <%= form.submit "Publish event →", class: "button-style regular" %>
  </div>
<% end %>