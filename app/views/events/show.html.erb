<div class="links">
  <%= link_to "Back to events", root_path %>
  <% if user_authorized? %>
  <%= link_to "Edit event", edit_user_event_path(@user.username, @event.id) %>
  <% end %>
</div>
<div class="event-body">
  <div><strong><%= pretty_string(@event.privacy) %></strong></div>
  <h2><%= @event.title %></h2>
  <p><%= @event.description %></p>
</div>
<div class="event-details">
  <div class="event-date"><%= @event.date %></div>
  <div class="event-time"><%= @event.time %></div>
  <div class="event-location"><%= @event.location %></div>
  <%= link_to pretty_string(@user.username), user_path(@user.username) %>
  <div class="event-control-button">
  <% if user_authorized? %>
    <div class="invite-user">
        <%= form_with url: attend_event_path, method: :post do |form |%>
            <%= form.text_field :invite_user %>
            <%= form.submit value: "Invite" %>
        <% end %>
    </div>
  <% else %>
    <%= attend_event_button(@event) %>
  </div>
  <% end %>
</div>
<div class="event-attendees">
  <% @event.attendees.each do |attendee| %>
  </div class="event-attendee">
    <p><%= display_attendee(attendee) %></p>
      <%= display_kick_button(attendee) %>
  </div>
  <% end %>
</div>