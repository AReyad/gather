<header>
    <nav class = "nav-bar">
    <h1><%= link_to "gather", root_path, class: "website-title" %></h1>
      <ul>
        <% if user_signed_in? %>
          <%= link_to new_event_path, class: "button-style regular" do %>
          <li>New Event</li>
          <% end %>
          <div class="nav-bar-user">
          <li class="button-style accent capitalize">
            <%= current_user.username %>
          </li>
            <div class="user-controls">
              <%= link_to "Your profile", user_path(current_user.username) %>
              <%= button_to "Log out", signout_path, method: :delete, data: { turbo: false }, class: "sign-out-btn" %>
            </div>
          </div>
        <% else %>
          <%= link_to signin_path, class: "button-style accent" do %>
            <li>Sign in</li>
          <% end %>
          <%= link_to signup_path, class: "button-style regular" do %>
          <li>Create an account</li>
          <% end %>
        <%end %>
      </ul>
    </nav>
</header>
<div class="border"></div>