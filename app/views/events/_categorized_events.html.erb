<div class="events-navigation">
  <%= link_to "Upcoming(#{upcoming_events.count})", "#upcoming-events", data: { turbo: false } %>
  <%= link_to "Past(#{past_events.count})", "#past-events", data: { turbo: false } %>
</div>
<section id="upcoming-events" class="events-category-wrapper">
  <h3>Upcoming</h3>
  <%= render "/events/events", events: upcoming_events, hide: hide_desc %>
</section>
<section id="past-events" class="events-category-wrapper">
  <h3>Past</h3>
  <%= render "/events/events", events: past_events, hide: hide_desc %>
</section>