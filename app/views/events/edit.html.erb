<div class="form">
<h2>Update your event</h2>
  <%= render "users/shared/error_messages", resource: @event %>
  <%= render "events/event_form", event: @event, url: edit_user_event_path %>
  <%= button_to "Delete Event", delete_event_path, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this event?" } %>
</div>
