      <div class="event-host"><span>Hosted by </span><%= link_to @user.username, user_path(@user.username), class: "capitalize" %></div>
      <div class="event-control-button">
      <% if user_authorized?(@event) %>
        <div class="invite-user">
            <%= form_with url: attend_event_path, method: :post do |form |%>
                <%= form.text_field :invite_user %>
                <%= form.submit value: "→" %>
            <% end %>
        </div>
      <% else %>
        <%= attend_event_button(@event, "button-style regular") %>
      <% end %>
      </div>
    </div>
    <div class="event-attendees">
      <div class="attendees-header event-attendees-padding">
        <h3>Attendees</h3>
        <p><%= @attendees_count %></p>
      </div>
      <% @event.attendees.each do |attendee| %>
      <div class="event-attendee event-attendees-padding">
        <p class="capitalize"> <%= display_attendee(attendee, @event) %> </p>
        <%= display_kick_button(attendee, @event) %>
      </div>
      <% end %>
    </div>
  </div>
</div>

