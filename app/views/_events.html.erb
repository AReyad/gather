<% if events.empty? %>
  <div class="empty-section">
    <p>No events to show.</p>
  </div>
<% else %>
  <% events.each do |event|%>
    <hr>
    <div class="event-card">
      <%= link_to user_event_path(event.host.username, event.id), class: "event-link" do %>
      <h3 class="event-title">Title: <%= event.title %></h3>
      <p class="event-description">Description: <%= event.description %></p>
      <p class="event-date">Date: <%= event.date %> · <%= display_time(event.time) %></p>
      <% end %>
    </div>
  <% end %>
<% end%>
