<h2>Create a new event</h2>
  <%= render "users/shared/error_messages", resource: @event %>
<%= form_with model: @event do |form|%>
  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, placeholder: "Rails Workshop 2026" %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_field :description, placeholder: "Deep dive into rails with our worksh..."  %>
  </div>

  <div class="field">
    <%= form.label :date %>
    <%= form.date_field :date %>
  </div>

  <div class="field">
    <%= form.label :time %>
    <%= form.time_field :time, value: "18:00" %>
  </div>

  <div class="field">
    <%= form.label :location %>
    <%= form.text_field :location, placeholder: "San Francisco, CA" %>
  </div>

  <div class="field">
    <%= form.label :privacy_public, "Public" %>
    <%= form.radio_button :privacy, :public, checked: true %>
    <%= form.label :privacy_private, "Private" %>
    <%= form.radio_button :privacy, :private %>
  </div>

  <div class="actions">
    <%= link_to "Cancel", root_path %>
    <%= form.submit "Publish event" %>
  </div>
<% end %>